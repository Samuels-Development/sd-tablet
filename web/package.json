{
    "name": "sd-tablet-ui",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "sync:sdk": "node -e \"const fs=require('node:fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync('../../sd-phone/web/public/components.js','public/components.js')\"",
        "dev": "npm run sync:sdk && vite",
        "build": "npm run sync:sdk && tsc --noEmit && vite build && node scripts/check-tailwind-output.mjs",
        "preview": "vite preview"
    },
    "dependencies": {
        "@fontsource/great-vibes": "5.3.0",
