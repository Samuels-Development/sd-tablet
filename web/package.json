        "html2canvas": "1.4.1",
        "lucide-react": "1.28.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "zustand": "5.0.14"
    },
    "devDependencies": {
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitejs/plugin-react": "6.0.5",
        "autoprefixer": "10.5.4",
        "postcss": "8.5.25",
        "tailwindcss": "3.4.19",
