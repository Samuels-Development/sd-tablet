{
    "name": "sd-tablet-ui",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "sync:sdk": "node -e \"require('fs').copyFileSync('../../sd-phone/web/public/components.js','public/components.js')\"",
        "dev": "npm run sync:sdk && vite",
        "build": "npm run sync:sdk && tsc --noEmit && vite build",
        "build:demo": "npm run sync:sdk && tsc --noEmit && vite build --mode demo",
        "preview": "vite preview"
    },
    "dependencies": {
        "@fontsource/great-vibes": "5.3.0",
        "@fontsource/inter": "5.3.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "html2canvas": "1.4.1",
        "lucide-react": "1.26.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "zustand": "5.0.14"
    },
    "devDependencies": {
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.4",
        "autoprefixer": "10.5.4",
        "postcss": "8.5.22",
        "tailwindcss": "3.4.19",
        "typescript": "5.9.3",
        "vite": "8.1.5"
    },
    "license": "GPL-3.0-or-later"
}
